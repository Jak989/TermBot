# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram numeric user id (only this id can use the bot)
TELEGRAM_ALLOWED_USER_ID=123456789

# Optional Slack Socket Mode bridge
SLACK_BOT_ENABLED=0
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Optional allow-list filters
SLACK_ALLOWED_USER_ID=
SLACK_ALLOWED_CHANNEL_ID=
# Optional startup ping channel (C...)
SLACK_STARTUP_CHANNEL_ID=

# Bot terminal runtime defaults
BOT_SHELL=/bin/zsh
BOT_CWD=/absolute/path/to/termbot
BOT_TIMEOUT_MS=0
BOT_STATUS_INTERVAL_MS=0
BOT_LIVE_STATUS_INTERVAL_MS=2000
BOT_ENTER_FALLBACK_MS=1200
BOT_CAPTURE_LINES=120
BOT_TURN_IDLE_DONE_MS=5000
BOT_CHAT_CODEX_FEEDBACK=0
BOT_CHAT_SEND_DONE_MARKER=0
BOT_CHAT_ESSENTIAL_MAX_CHARS=600
BOT_CHAT_ESSENTIAL_MAX_LINES=5
BOT_CODEX_BACKEND=tmux
BOT_TMUX_BIN=tmux
BOT_PROMPT_ON_START=1
BOT_ENABLE_RESTART_COMMAND=1
BOT_SINGLE_INSTANCE=1
BOT_RESTART_HEALTH_TIMEOUT_MS=15000
BOT_RESTART_READY_FILE=data/runtime/restart-ready.json
BOT_AUTO_START_CODEX=1
BOT_STARTUP_SEND_PANEL=1
BOT_STARTUP_BOOT_DELAY_MS=1500
# optional, fallback is TELEGRAM_ALLOWED_USER_ID
BOT_STARTUP_CHAT_ID=
BOT_WEBAPP_URL=
BOT_WEB_PORT=8787
BOT_WEB_HOST=127.0.0.1
BOT_WEBAPP_ENABLE=1
BOT_WEBAPP_AUTO_MENU=1
BOT_WEBAPP_REFRESH_MS=1200
BOT_WEBAPP_MAX_SCREEN_CHARS=8000
MINIAPP_RATE_WINDOW_MS=60000
MINIAPP_RATE_LIMIT_LIVE=180
MINIAPP_RATE_LIMIT_INPUT=40
BOT_PERSONALITY_AUTO_APPLY=1
BOT_PERSONALITY_FILE=V3_PERSONALITY.md
BOT_PERSONALITY_MAX_CHARS=12000
BOT_VOICE_ENABLED=1
BOT_VOICE_MAX_DURATION_SEC=240
BOT_VOICE_TRANSCRIBE_BIN=python3
# default resolves to: $CODEX_HOME/skills/transcribe/scripts/transcribe_diarize.py
BOT_VOICE_TRANSCRIBE_SCRIPT=
BOT_VOICE_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
BOT_VOICE_LANGUAGE=
BOT_VOICE_ECHO_TRANSCRIPT=1
BOT_VOICE_KEEP_FILES=0
BOT_VOICE_TRANSCRIBE_TIMEOUT_MS=180000

# Optional Notion activity sync (reminders + key bot activities)
NOTION_SYNC_ENABLED=0
# auto = API token when present, otherwise MCP via local codex login
NOTION_SYNC_MODE=auto
# Optional: path/name for codex binary used in MCP sync mode
NOTION_SYNC_CODEX_BIN=codex
NOTION_SYNC_CODEX_MODEL=
NOTION_SYNC_CODEX_TIMEOUT_MS=120000
NOTION_API_TOKEN=
NOTION_DATABASE_ID=
NOTION_TIMEOUT_MS=8000

# Local web app hardening defaults (server.js)
HOST=127.0.0.1
PORT=3000
API_LOCAL_ONLY=1
JSON_BODY_LIMIT=200mb

# Standalone codexbot defaults (local daemon + CLI)
CODEX_BIN=codex
CODEX_HOME=/absolute/path/to/.codex
CODEX_CWD=/absolute/path/to/termbot
CODEX_MODEL=
CODEX_USE_OSS=0
CODEX_LOCAL_PROVIDER=
# Safety default: keep approvals/sandbox enabled unless you explicitly opt out
CODEX_YOLO=0
CODEXBOT_SOCKET_PATH=/tmp/codexbot.sock
CODEXBOT_CANCEL_FALLBACK_MS=2500
